# SQLite Database URL (async URL for FastAPI)
DATABASE_URL=sqlite+aiosqlite:///./roadwatch.db

# Sync URL for Alembic migrations or sync tools
DATABASE_URL_SYNC=sqlite:///./roadwatch.db

# CORS (comma-separated origins, or * for dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEBUG=false

# JWT — generate: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Optional first-run admin account
BOOTSTRAP_ADMIN_EMAIL=admin@roadwatch.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123!
